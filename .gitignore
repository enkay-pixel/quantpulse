# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Secrets & local config
.env
.env.*
!.env.example
.claude/settings.local.json

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data & artifacts (regenerable, live in Postgres/MLflow volumes).
# Root-anchored: a bare `data/` would also match src/quantpulse/data and
# hatchling excludes gitignored paths from the wheel.
/data/
/mlruns/
/mlartifacts/
/artifacts/
*.parquet

# Local experiment DBs
*.db

# dbt build artifacts
transform/target/
transform/dbt_packages/
transform/logs/
logs/

# Dagster
.dagster_home/
tmp*/

# Node / frontend
node_modules/
web/dist/

# OS / editor
.DS_Store
.idea/

# Jupyter
.ipynb_checkpoints/

# dbt machine-local state
transform/.user.yml

# Obsidian: the repo root doubles as a vault (see docs/README.md). Shared settings are
# committed so the link format and exclusions hold for anyone who opens it; per-machine
# state is not. workspace*.json rewrites itself on every pane you move, and plugin
# data.json is where plugins keep their credentials.
.obsidian/workspace*.json
.obsidian/cache
.obsidian/plugins/*/data.json
